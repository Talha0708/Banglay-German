    "grammarTip": {
      "title_bn": "'Guten Tag' বনাম 'Gute Nacht' এর রহস্য",
      "title_en": "Why 'Guten' vs 'Gute'?",
      "content_bn": "খেয়াল করেছেন কেন Guten Morgen, Guten Tag, Guten Abend কিন্তু 'Gute' Nacht?\nকারণ Morgen, Tag ও Abend হলো পুংলিঙ্গ (der Tag, der Morgen), যা শুভেচ্ছা বাক্যে Akkusativ এ 'Guten' হয়।\nকিন্তু Nacht হলো স্ত্রীলিঙ্গ (die Nacht), তাই Akkusativ এ এর শেষে কেবল '-e' যুক্ত হয়ে হয় 'Gute Nacht'!",
      "rule_table": [
        { "label": "der Tag", "value": "Guten Tag!", "note": "পুংলিঙ্গ -> -en" },
        { "label": "der Morgen", "value": "Guten Morgen!", "note": "পুংলিঙ্গ -> -en" },
        { "label": "die Nacht", "value": "Gute Nacht!", "note": "স্ত্রীলিঙ্গ -> -e" }
      ]
    },
