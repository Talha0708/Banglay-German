  "grammarTip": {
    "title_bn": "২১ থেকে ১০০ পর্যন্ত জার্মান সংখ্যা গঠনের সূত্র",
    "title_en": "Compound Numbers (21–99) & Prices",
    "content_bn": "২১ থেকে ৯৯ পর্যন্ত সংখ্যা সবসময় একটি শব্দ হিসেবে লেখা হয়:\n[এককের ঘরের অঙ্ক] + und + [দশকের ঘরের অঙ্ক]\nউদাহরণ:\n• 21 = ein + und + zwanzig = einundzwanzig\n• 35 = fünf + und + dreißig = fünfunddreißig\n• 48 = acht + und + vierzig = achtundvierzig\n• 99 = neun + und + neunzig = neunundneunzig\nদাম জিজ্ঞেস করতে: 'Was kostet das?' বা 'Wie viel kostet das?'\nদাম বলতে: 'Das kostet 2,50 €' (zwei Euro fünfzig)।",
    "rule_table": [
      { "label": "21", "value": "einundzwanzig", "note": "১ + এবং + ২০" },
      { "label": "35", "value": "fünfunddreißig", "note": "৫ + এবং + ৩০" },
      { "label": "77", "value": "siebenundsiebzig", "note": "৭ + এবং + ৭০" },
      { "label": "100", "value": "hundert", "note": "একশত" },
      { "label": "3,50 €", "value": "drei Euro fünfzig", "note": "ইউরো ও সেন্টের দাম" }
    ]
  },
