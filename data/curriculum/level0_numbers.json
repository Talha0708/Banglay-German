  "grammarTip": {
    "title_bn": "জার্মান সংখ্যা গঠনের মূল সূত্র (২১–৯৯)",
    "title_en": "The 21–99 Compound Number Rule",
    "content_bn": "২১ থেকে ৯৯ পর্যন্ত সংখ্যা সবসময় এক শব্দে লেখা হয়:\n[এককের ঘরের অঙ্ক] + und + [দশকের ঘরের অঙ্ক]\nউদাহরণ:\n• 21 = ein + und + zwanzig = einundzwanzig\n• 34 = vier + und + dreißig = vierunddreißig\n• 58 = acht + und + fünfzig = achtundfünfzig\nফোন নম্বর পড়ার সময় সাধারণত একটি বা দুটি করে সংখ্যা আলাদা করে উচ্চারণ করা হয় (যেমন: null-eins-sieben...)।",
    "rule_table": [
      { "label": "21", "value": "einundzwanzig", "note": "এক এবং বিশ" },
      { "label": "35", "value": "fünfunddreißig", "note": "পাঁচ এবং ত্রিশ" },
      { "label": "100", "value": "hundert", "note": "একশত" },
      { "label": "1000", "value": "tausend", "note": "এক হাজার" }
    ]
  },
