      { "de": "im Sommer / im Januar", "bn": "গ্রীষ্মকালে / জানুয়ারিতে", "note": "মাস ও ঋতুর আগে 'im' বসে" },
      { "de": "Wie viel Uhr ist es? / Wie spät ist es?", "bn": "কয়টা বাজে?", "note": "সময় জিজ্ঞেস করার মূল বাক্য" },
      { "de": "Es ist 8 Uhr. (um 8 Uhr)", "bn": "এখন আটটা বাজে। (আটটায়)", "note": "সময়ের আগে 'um' বসে" },
      { "de": "Es ist halb drei.", "bn": "এখন আড়াইটা (২:৩০) বাজে।", "note": "পরবর্তী ঘণ্টা ৩ এর অর্ধেক বাকি" },
      { "de": "Es ist Viertel nach acht.", "bn": "এখন সোয়া আটটা (৮:১৫)।", "note": "আটটা বেজে ১৫ মিনিট" },
      { "de": "Der Himmel ist blau und das Gras ist grün.", "bn": "আকাশ নীল এবং ঘাস সবুজ।", "note": "রং এর ব্যবহার" }
    ]
  },
