        { "label": "du", "value": "kannst / musst / willst", "note": "-st যুক্ত হয়" },
        { "label": "Sentence End", "value": "Infinitiv Verb (sprechen, gehen)", "note": "বাক্যের শেষে মূল ক্রিয়া" }
      ]
    },
